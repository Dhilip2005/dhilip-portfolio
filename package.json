{
  "name": "dhilip-kumar-portfolio",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"npm:server:dev\" \"npm:client:dev\"",
    "client:dev": "vite client --config client/vite.config.js",
    "server:dev": "node --watch server/server.js",
    "build": "vite build client --config client/vite.config.js",
    "preview": "vite preview client --config client/vite.config.js",
    "start": "node server/server.js"
  },
  "dependencies": {
    "@react-three/drei": "^9.122.0",
    "@react-three/fiber": "^8.17.10",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "framer-motion": "^11.15.0",
    "helmet": "^8.0.0",
    "lucide-react": "^0.468.0",
    "nodemailer": "^10.6.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.5",
    "three": "^0.171.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "4.7.0",
    "concurrently": "^9.1.0",
    "vite": "6.4.6"
  }
}
